# Google AI Studio (aistudio.google.com) で発行したAPIキー
GEMINI_API_KEY=
# 使用するモデル（AI Studioで最新のモデル名を確認して変更可）
GEMINI_MODEL=gemini-3.8-flash
# メインのモデルが混雑しているときに順に試す予備モデル（カンマ区切り）
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# notion.so/my-integrations で作成したインテグレーションのシークレット
NOTION_TOKEN=
# データベースURLの32文字のID
NOTION_DATABASE_ID=
